# Copy to .env and fill in what you have. Everything is optional for v1 —
# the app falls back gracefully when a provider is not configured.

# --- Data source priority (highest first) ---

# 1. SerpApi Google Showtimes engine (recommended for v1).
#    Free tier: 250 searches/month. Get a key at https://serpapi.com/
#    Note: one search costs one request per in-range theater (Google only serves
#    showtimes for theater-name queries), so radius and theaters.json size drive
#    quota use. See README "How quota is spent".
SERPAPI_KEY=

# 2. MovieGlu API (optional). https://developer.movieglu.com/
MOVIEGLU_API_KEY=
MOVIEGLU_CLIENT=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_TERRITORY=US
MOVIEGLU_API_VERSION=v201

# 3. Playwright scraping fallback needs no key, but respects robots.txt
#    and is rate-limited. Toggle it on/off here.
ENABLE_SCRAPER_FALLBACK=false

# Seat verification: render a booking page with Playwright and parse its seat map
# to upgrade "check manually" into a real match/no-match (honoring seats_together
# + min_row + row normalization). Needs `playwright install chromium`. Off by
# default. Selectors live in scrape_selectors.json and should be verified with the
# debug harness (see README) before trusting live results.
ENABLE_SEAT_VERIFICATION=false
SEAT_VERIFICATION_MAX=12
SEAT_VERIFICATION_CACHE_TTL_SEC=600

# --- Theater resolution ---
# If set, candidate theaters are resolved via Google Places. Otherwise the
# app reads the editable theaters.json at the repo root.
GOOGLE_PLACES_API_KEY=

# --- Database ---
# SQLite for v1. To migrate to Postgres later, just change this URL, e.g.
# postgresql+psycopg://user:pass@host:5432/showtime_finder
DATABASE_URL=sqlite:///./showtime_finder.db

# --- App ---
# Comma-separated allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests/second cap applied to scraping (be polite).
SCRAPE_RATE_LIMIT_PER_SEC=0.5

# Cache identical searches for this many seconds to conserve the SerpApi
# free-tier quota (100/month) and speed up repeat searches. 0 disables it.
SEARCH_CACHE_TTL_SEC=300
